-- constants
snake_spr=1
apple=2
snake={}
cell_size=8

function _init()
	add(snake, {x=7,y=7})
	add(snake, {x=6,y=7})
	add(snake, {x=5,y=7})

    direction=-1
end

function _update60()
end

function _draw()
    cls()
    draw_snake()
end

-->8
-- =================
-- Update
-- =================
function update_snake()
    if direction==-1 then
        for i=1, len, 1 do
            snake[i].x+=direction
        end
end

-->8
-- =================
-- Draw
-- =================
function draw_snake()
	local len=#snake
	for i=1, len, 1 do
		local body=snake[i]
		spr(snake_spr,body["x"]*cell_size,body["y"]*cell_size)
	end
end



